# Copy to .env for local runs. Any provider left blank is reported as
# failed/skipped by /benchmark; the service itself still starts.

# Database (omit to use ./stt_benchmark.db via SQLite)
DATABASE_URL=

# Comma-separated allowed origins for the frontend (default: *)
CORS_ORIGINS=

# Azure Speech
SPEECH_KEY=
ENDPOINT=

OPENAI_API_KEY=
ELEVENLABS_API_KEY=
REVAI_API_KEY=
SARVAM_API_KEY=
SONIOX_API_KEY=
GOOGLE_STT_API_KEY=

# Self-hosted AI4Bharat IndicConformer service (see SASHI117/ai4bharat_stt)
AI4BHARAT_STT_URL=http://localhost:8000/stt
AI4BHARAT_API_KEY=
